# Rendered by the nginx image's envsubst step; only ${API_UPSTREAM} is substituted.

# Pass the client's real scheme and host to Spring. Behind another proxy (the DSM
# reverse proxy terminating TLS) the X-Forwarded-* headers it set win; when nginx is
# the edge they fall back to this request's own values. Spring rebuilds the request
# URL from them (server.forward-headers-strategy=framework), which is what lets it
# recognise a browser POST carrying Origin: https://family.example as same-origin
# instead of rejecting it as an "Invalid CORS request".
map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}
map $http_x_forwarded_host $fwd_host {
    default $http_x_forwarded_host;
    ""      $http_host;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/manifest+json image/svg+xml;

    # The SPA entry and the service worker must never be cached, or an updated
    # build would not reach a kiosk that reloads every night.
    location = /index.html { add_header Cache-Control "no-cache"; }
    location = /sw.js { add_header Cache-Control "no-cache"; }
    location = /registerSW.js { add_header Cache-Control "no-cache"; }
    location = /manifest.webmanifest { add_header Cache-Control "no-cache"; }

    # Vite's hashed assets can be cached forever.
    location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }

    # Same-origin API: the browser talks to /api here, nginx forwards to Spring Boot.
    location /api/ {
        proxy_pass http://${API_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_set_header X-Forwarded-Host $fwd_host;
        proxy_read_timeout 60s;
        # Theme pack imports and backup restores carry embedded images.
        client_max_body_size 16m;
    }

    # SPA fallback: deep links such as /settings?googleConnected=true load index.html.
    location / { try_files $uri $uri/ /index.html; }
}
