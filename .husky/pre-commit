npx lint-staged
# Secret scan of the staged changes. Fails closed: a missing scanner is not a pass.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is required (brew install gitleaks); refusing to commit unscanned changes" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --no-banner --redact=100
